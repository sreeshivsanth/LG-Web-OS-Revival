FROM node:22-bookworm-slim AS node
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive CPU_FEATURES=0 NODE_OPTIONS=--no-addons
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssh-client git bash python3 make g++ && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/ /usr/local/
RUN npm install --global @webos-tools/cli@3.2.6 && ares -V
RUN useradd --create-home --uid 1000 developer
USER developer
WORKDIR /workspace
CMD ["bash"]
